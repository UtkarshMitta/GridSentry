# Copy to apps/api/.env (gitignored). Every value is optional — the API runs
# fully without keys: jurisdiction is verified via the keyless U.S. Census
# geocoder, and report narratives fall back to the deterministic engine.

# Adds web sources on the state's wetland program to a verified jurisdiction.
TAVILY_API_KEY=

# LLM for narrative summaries (OpenAI is used if both keys are set).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
