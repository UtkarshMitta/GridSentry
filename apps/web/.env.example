# Copy to apps/web/.env.local (gitignored) and uncomment what you need.
# All optional for local dev; empty values fall back to the defaults.

# API the browser calls. Read at BUILD time — redeploy after changing it.
# Default: http://localhost:8000 in dev, https://gridsentry-api.onrender.com in production.
# NEXT_PUBLIC_API_URL=

# API the server-side PDF route calls (same default as above).
# API_URL=

# Basemap tile URL template (Leaflet {z}/{x}/{y} syntax). Default: Esri World
# Dark Gray (keyless). Setting this also drops the default label layer.
# NEXT_PUBLIC_TILE_URL=
# Attribution HTML required by that provider (shown in the map corner).
# NEXT_PUBLIC_TILE_ATTRIBUTION=
