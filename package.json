{
  "name": "gridsentry",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently -n web,api -c green,cyan \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:api": "cd apps/api && ./.venv/bin/uvicorn main:app --reload --port 8000",
    "setup:api": "cd apps/api && python3 -m venv .venv && ./.venv/bin/pip install -r requirements-dev.txt",
    "build": "npm run build --workspace apps/web",
    "lint": "npm run lint:api && npm run lint:web",
    "lint:api": "cd apps/api && ./.venv/bin/ruff check .",
    "lint:web": "npm run lint --workspace apps/web",
    "typecheck": "cd apps/web && npx tsc --noEmit",
    "test:api": "cd apps/api && ./.venv/bin/python -m pytest",
    "test:web": "npm test --workspace apps/web",
    "test:live": "cd apps/api && GRIDSENTRY_LIVE=1 ./.venv/bin/python -m pytest tests/test_live_sites.py -v"
  },
  "workspaces": [
    "apps/web"
  ],
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
